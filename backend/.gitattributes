# Auto detect text files and normalize line endings to LF
* text=auto

# JSON
*.json text eol=lf

# JavaScript/Node
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Markdown
*.md text eol=lf

# HTTP
*.http text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Shell
*.sh text eol=lf

# Batch/PowerShell
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.fnt binary
